# ClaimShield AI — Environment Variables Example
# Copy this file to .env and adjust values for your environment.
# .env is gitignored; .env.example is safe to commit.

# ─────────────────────────────────────────────
# Phase 3: Kafka Configuration
# ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=insurance_claims
KAFKA_GROUP_ID=claimshield-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# ─────────────────────────────────────────────
# Phase 4: HDFS Configuration (WebHDFS REST)
# ─────────────────────────────────────────────
HDFS_HOST=localhost
HDFS_PORT=9870
HDFS_USER=root
HDFS_BASE_PATH=/claimshield/claims

# ─────────────────────────────────────────────
# Phase 5: ML Model & Analytics Configuration
# ─────────────────────────────────────────────
# Paths are relative to the project root (where app.py lives)
MODEL_PATH=model.pkl
ENCODER_PATH=encoder.pkl
METADATA_PATH=metadata.pkl
ANALYTICS_OUTPUT_DIR=analytics_output
FRAUD_THRESHOLD=0.70
